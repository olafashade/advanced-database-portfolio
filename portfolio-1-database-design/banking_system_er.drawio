ULL DEFAULT 0.00&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;34&quot; align=&quot;center&quot;&gt;&amp;nbsp;&lt;/td&gt;&lt;td width=&quot;125&quot; align=&quot;left&quot;&gt;&lt;b&gt;paid_on&lt;/b&gt;&lt;/td&gt;&lt;td width=&quot;105&quot; align=&quot;left&quot;&gt;DATE&lt;/td&gt;&lt;td align=&quot;left&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0097A7;strokeWidth=2;align=left;verticalAlign=top;spacing=0;fontSize=12;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="470" y="600" width="360" height="220" as="geometry" /></mxCell><mxCell id="r_branch_account" value="operates / has accounts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="branch" target="account"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r_customer_account" value="owns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="customer" target="account"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r_customer_loan" value="applies for" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="customer" target="loan"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r_loan_repayment" value="has repayment schedule" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="loan" target="loan_repayment"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r_account_from" value="source account (from_acc)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="account" target="transaction"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r_account_to" value="destination account (to_acc)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="account" target="transaction"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; = Primary key &amp;nbsp;&amp;nbsp; &lt;b&gt;FK&lt;/b&gt; = Foreign key &amp;nbsp;&amp;nbsp; &lt;b&gt;UQ&lt;/b&gt; = Unique constraint&lt;br&gt;One branch → many accounts; one customer → many accounts and loans; one loan → many repayments.&lt;br&gt;One account may appear in many transactions as either the source or destination account." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="70" width="370" height="100" as="geometry" /></mxCell><mxCell id="audit_note" value="&lt;b&gt;AUDIT LOG NOTE&lt;/b&gt;&lt;br&gt;audit_log has no declared foreign key in the supplied schema. It is intentionally shown without a relationship line. Application-level logging may reference actors or records in detail, but that is not enforced by this DDL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="630" width="300" height="140" as="geometry" /></mxCell><mxCell id="schema_note" value="&lt;b&gt;SCHEMA NOTES&lt;/b&gt;&lt;br&gt;• transaction is the table name as supplied; PostgreSQL installations may treat it as a keyword in some contexts, so consider renaming it (e.g. bank_transaction) or quoting it consistently.&lt;br&gt;• from_acc and to_acc both reference account.account_no. Their relationship roles are distinct.&lt;br&gt;• CHECK and DEFAULT rules are summarized in each entity where space permits." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="520" width="370" height="210" as="geometry" /></mxCell><mxCell id="title" value="&lt;b style=&quot;font-size:24px&quot;&gt;Banking System – ER Diagram&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=20;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="300" y="0" width="800" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>